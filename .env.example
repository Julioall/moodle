APP_PORT=8787
APP_DOMAIN=
COMPOSE_PROFILES=
CADDYFILE=./deploy/Caddyfile

# Runtime identity exposed by get_connector_build_info and /api/status.
# CI/CD should inject the immutable commit and a unique build id.
MOODLE_VERSION=
MOODLE_COMMIT=
MOODLE_BUILD_ID=
MOODLE_BUILD_AT=
MOODLE_DEPLOYED_AT=
MOODLE_SOURCE_REF=

POSTGRES_DB=MOODLE
POSTGRES_USER=MOODLE
POSTGRES_PASSWORD=change-me
Postgres__ConnectionString=Host=postgres;Port=5432;Database=MOODLE;Username=MOODLE;Password=change-me

ConnectorSecrets__EncryptionKeyBase64=replace-with-32-byte-base64-key
DataProtection__KeyStoragePath=/app/data/keys
# Persistent package ZIP storage. For multiple app replicas, use a shared filesystem.
GRADING_PACKAGE_BLOB_ROOT_DIRECTORY=/app/data/private-grading-packages
AdminApi__ApiKey=replace-with-admin-api-key
# Obrigatória em produção para MediatR 13; mantenha a chave fora do repositório.
MEDIATR_LICENSE_KEY=

McpServerSecurity__RequireJwt=false
McpServerSecurity__RequireApiKey=true
PasswordRecovery__DefaultPassword=@Moodle123#

# When APP_DOMAIN is set, Issuer defaults to https://APP_DOMAIN and Audience to https://APP_DOMAIN/mcp.
OAuth__Issuer=http://localhost:8787
OAuth__Audience=http://localhost:8787/mcp
# Optional static-client fallback for older connections; new ChatGPT connections use DCR.
OAuth__ChatGptRedirectUri=
OAuth__ScopeName=moodle-mcp-audience
OAuth__RequireHttpsMetadata=false
OAuth__AccessTokenMinutes=60
OAuth__RefreshTokenDays=30
OAuth__KeyStoragePath=/app/data/oauth
OAuth__CertificateYears=5

RateLimiting__WindowSeconds=60
RateLimiting__AppAuthPermitLimit=12
RateLimiting__AccountAuthPermitLimit=12
RateLimiting__AccountAuthMaximumTrackedPartitions=10000
RateLimiting__AccountAuthIdleExpirationMinutes=30
RateLimiting__AdminApiPermitLimit=30
RateLimiting__McpPermitLimit=120
Admission__IngressMode=Legacy
Admission__MoodleEgressMode=Legacy
Admission__LocalReadPermitLimitPerMinute=120
Admission__LocalReadBurst=40
Admission__MaximumTrackedPartitions=10000
Admission__IdlePartitionExpirationMinutes=30

# Add only the reverse proxy's actual source range. The deploy workflow uses
# the default Compose private network range; narrow it when the host uses a
# dedicated Docker subnet. Arbitrary forwarded headers are ignored.
ForwardedHeaders__ForwardLimit=1
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

MoodleApi__BaseUrl=
MoodleApi__ServiceToken=
MoodleApi__WriteServiceToken=
MoodleApi__AllowServiceTokenForReadOnlyQueries=false
# Somente domínios corporativos revisados podem resolver para IP privado.
# Ex.: MoodleApi__TrustedPrivateEndpointHosts__0=ead.fieg.com.br
MoodleApi__TrustedPrivateEndpointHosts__0=
# Opcional: força uma conexão TCP nova por escrita para hosts DNS exatos.
# Habilite somente no ambiente aprovado; omita o índice para manter o pool atual.
# MoodleApi__FreshWriteConnectionHosts__0=ead.fieg.com.br

# LiveShadow/MoodleBench credentials are loaded only from the ignored .env or
# the process environment; never commit real usernames, passwords, or keys.
LIVE_SENAI_URL=https://ead.senai.br
LIVE_SENAI_USERNAME=
LIVE_SENAI_PASSWORD=
LIVE_FIEG_URL=https://ead.fieg.com.br
LIVE_FIEG_USERNAME=
LIVE_FIEG_PASSWORD=
OPENAI_API_KEY=

# MoodleBench: defaults to the fast development/debug model.
MOODLEBENCH_MODEL=gpt-5.4-nano
# Use gpt-5.5 or gpt-5.6-sol for final validation runs.
MoodleApi__UseStubData=false
MoodleApi__HttpTimeoutSeconds=30
MoodleApi__HttpRetryCount=2
MoodleApi__CircuitBreakerHandledEventsAllowedBeforeBreaking=5
MoodleApi__CircuitBreakerDurationSeconds=30

# /api/reports/student-course usa as credenciais Moodle da conexao associada a api_key.
# O usuario Moodle precisa visualizar e exportar os relatorios 509 e 512.

MoodleProxy__BaseUrl=
MoodleProxy__ApiKey=
MoodleProxy__UseStubData=false
MoodleProxy__HttpTimeoutSeconds=30
MoodleProxy__HttpRetryCount=2
MoodleProxy__CircuitBreakerHandledEventsAllowedBeforeBreaking=5
MoodleProxy__CircuitBreakerDurationSeconds=30

# Explicit write capabilities for an approved environment. Docker Compose maps
# these deployment variables to the application's Features section.
FEATURES_MESSAGES_WRITE_ENABLED=true
FEATURES_ASSIGNMENT_FEEDBACK_WRITE_ENABLED=true
FEATURES_ASSIGNMENT_GRADE_WRITE_ENABLED=true
Features__ScheduledMessagesEnabled=false
Features__UniversalMoodleWriteEnabled=false
Features__UniversalMoodleFileDownloadEnabled=false
Features__CourseContentWriteEnabled=false
Features__ProfessionalAgendaEnabled=false
Features__ProfessionalTasksEnabled=false

Ocr__Enabled=true
Ocr__Language=por
Ocr__TessDataPath=/usr/share/tesseract-ocr/5/tessdata
Ocr__MinConfidence=30
Ocr__MaxPdfPagesForOcr=20
