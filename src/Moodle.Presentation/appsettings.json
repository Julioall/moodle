{
  "McpServerSecurity": {
    "RequireJwt": false,
    "RequireApiKey": true,
    "ApiKeyHeader": "X-Mcp-Api-Key"
  },
  "Postgres": {
    "ConnectionString": "Host=PLACEHOLDER;Database=PLACEHOLDER;Username=PLACEHOLDER;Password=PLACEHOLDER"
  },
  "ConnectorSecrets": {
    "EncryptionKeyBase64": "REPLACE_WITH_32_BYTE_BASE64_KEY",
    "TokenCacheMinutes": 20
  },
  "AdminApi": {
    "HeaderName": "X-Admin-Api-Key",
    "ApiKey": "REPLACE_WITH_ADMIN_API_KEY"
  },
  "OAuth": {
    "Issuer": "http://localhost:8787",
    "Audience": "http://localhost:8787/mcp",
    "ChatGptClientId": "moodle",
    "ChatGptRedirectUri": "",
    "ScopeName": "moodle-mcp-audience",
    "RequireHttpsMetadata": false,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "KeyStoragePath": "App_Data/oauth",
    "CertificateYears": 5
  },
  "UserClaims": {
    "UserIdClaim": "sub",
    "MoodleUserIdClaim": "moodle_user_id",
    "WritePermissionClaim": "scope",
    "WritePermissionValue": "moodle.write"
  },
  "Features": {
    "AppV2Enabled": false,
    "CourseDetailsOverviewV1Enabled": false,
    "MessagesWriteEnabled": false,
    "ScheduledMessagesEnabled": false,
    "AssignmentFeedbackWriteEnabled": false,
    "AssignmentGradeWriteEnabled": false,
    "UniversalMoodleWriteEnabled": false,
    "UniversalMoodleFileDownloadEnabled": false,
    "McpResourceSubmissionDeliveryEnabled": true,
    "LegacySubmissionExtractionEnabled": false,
    "McpResourceZipEnabled": false,
    "McpGradingDraftEnabled": false,
    "McpGradingWriteEnabled": false,
    "McpGradingSecurityWarningsOnly": true,
    "CourseContentWriteEnabled": false,
    "ProfessionalAgendaEnabled": false,
    "ProfessionalTasksEnabled": false
  },
  "PasswordRecovery": {
    "DefaultPassword": "@Moodle123#"
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "AppAuthPermitLimit": 12,
    "AccountAuthPermitLimit": 12,
    "AccountAuthMaximumTrackedPartitions": 10000,
    "AccountAuthIdleExpirationMinutes": 30,
    "AdminApiPermitLimit": 30,
    "McpPermitLimit": 120
  },
  "Admission": {
    "IngressMode": "Legacy",
    "MoodleEgressMode": "Legacy",
    "LocalReadPermitLimitPerMinute": 120,
    "LocalReadBurst": 40,
    "MaximumTrackedPartitions": 10000,
    "IdlePartitionExpirationMinutes": 30
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": [
      "127.0.0.1/32",
      "::1/128"
    ]
  },
  "Moodle": {
    "PendingActionExpirationMinutes": 15,
    "VolatilePendingActionExpirationHours": 48,
    "StablePendingActionExpirationHours": 168
  },
  "GradingLimits": {
    "MaxBatchItems": 400,
    "MaxFileSizeMb": 25,
    "MaxScormPackageResourceBytes": 104857600,
    "MaxResourceBytes": 26214400,
    "ResourceExpirationMinutes": 1440,
    "MaxConcurrentResourceDownloads": 4,
    "MaxZipEntries": 100,
    "MaxExtractedZipBytes": 104857600,
    "MaxFilesPerSubmission": 10,
    "MaxTextCharsPerSubmission": 120000,
    "MaxReviewItemsPerPage": 25,
    "PublicationRecommendedMaxItems": 20,
    "PublicationPreflightBatchSize": 5,
    "EnableBatchGradeWrite": false,
    "PublicationWriteBatchSize": 5,
    "PublicationPreflightMaxAgeSeconds": 120,
    "RawFileRetentionDays": 7,
    "DraftRetentionDays": 180,
    "MoodleMaxConcurrentRequests": 5,
    "FileDownloadWorkers": 4,
    "MaxConcurrentDownloadsPerConnection": 4,
    "MaxConcurrentDownloadsPerBatch": 4,
    "ExtractionWorkers": 4,
    "AiAnalysisWorkers": 3,
    "DeferHeavyIngestion": true,
    "BatchLeaseMinutes": 30,
    "DurableBatchPollSeconds": 5,
    "DurableBatchClaimSize": 8,
    "BatchWorkerConcurrency": 2,
    "AdaptiveBatchWorkerConcurrency": true,
    "BatchWorkerMinConcurrency": 1,
    "BatchWorkerMaxConcurrency": 0,
    "BatchWorkerCpuTargetPercent": 80,
    "BatchWorkerMemoryTargetPercent": 80,
    "BatchWorkerScaleIntervalSeconds": 5,
    "BatchWorkerIdleScaleDownSeconds": 30,
    "BatchWorkerMemoryPerWorkerMb": 256,
    "BatchWorkerPerConnectionConcurrency": 2,
    "PublicationWorkerPollSeconds": 5,
    "PublicationWorkerConcurrency": 2,
    "PublicationWorkerPerConnectionConcurrency": 1,
    "BatchCreationTimeoutSeconds": 75,
    "PublicationReviewExpirationHours": 168,
    "GradingPackageSubmissionReuseEnabled": false,
    "GradingPackageSubmissionReuseSeconds": 30,
    "GradingPackageSubmissionCacheMaxBytes": 134217728
  },
  "MoodleSnapshots": {
    "QueueCapacity": 256,
    "GlobalConcurrency": 2,
    "PerConnectionConcurrency": 1,
    "FeedbackReadConcurrency": 1,
    "BulkGradebookEnabled": true,
    "MaxBulkGradebookStudents": 200,
    "MaxBulkGradebookCells": 20000,
    "IndividualGradebookConcurrency": 2,
    "GradebookFreshMinutes": 15,
    "GradebookStaleMinutes": 120,
    "GradebookFreezeAfterCourseEndDays": 30,
    "MaxAnalyticalSnapshotSkewMinutes": 15,
    "MaxPayloadBytes": 10485760,
    "MaxCoursePayloadBytes": 33554432,
    "CoursePageSize": 250,
    "MaxCoursePages": 100,
    "ParticipantPageSize": 1000,
    "MaxParticipantPages": 100,
    "AssignmentBatchSize": 100,
    "AssignmentGradeBatchSize": 50,
    "RunRetentionDays": 30,
    "CleanupIntervalMinutes": 60,
    "LeaseMinutes": 30
  },
  "MoodleProxy": {
    "BaseUrl": "https://seu-proxy.exemplo.com",
    "ApiKey": "",
    "UseStubData": false,
    "HttpTimeoutSeconds": 30,
    "HttpRetryCount": 4,
    "CircuitBreakerHandledEventsAllowedBeforeBreaking": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "MoodleApi": {
    "BaseUrl": "https://seu-moodle.exemplo.com",
    "ServiceToken": "",
    "LoginService": "moodle_mobile_app",
    "AllowServiceTokenForReadOnlyQueries": false,
    "TrustedPrivateEndpointHosts": [],
    "UseStubData": false,
    "HttpTimeoutSeconds": 30,
    "HttpRetryCount": 4,
    "CircuitBreakerHandledEventsAllowedBeforeBreaking": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "ReportArtifacts": {
    "RootDirectory": "private-report-artifacts"
  },
  "Schema": {
    "ApplyOnStartup": true,
    "MigrationOnly": false
  },
  "MoodleCallDiagnostics": {
    "Enabled": true,
    "RetentionDays": 30,
    "WriteTimeoutMilliseconds": 250,
    "CleanupIntervalHours": 24,
    "CleanupBatchSize": 500,
    "MaxCleanupBatchesPerRun": 20
  },
  "MoodleHttpTransport": {
    "ReadMaxConnectionsPerServer": 1
  },
  "MoodleReadLimits": {
    "Enabled": false,
    "Retry429Enabled": false,
    "MaxConcurrentPerConnection": 2,
    "MaxConcurrentForumPostReads": 1,
    "QueueLimitPerConnection": 20,
    "QueueWaitTimeoutSeconds": 10,
    "MaxTrackedConnections": 512
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
